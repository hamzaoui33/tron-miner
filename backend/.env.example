# Server (local dev only — Vercel ignores PORT)
PORT=3001
NODE_ENV=development

# Database — use Supabase Transaction Pooler for Vercel serverless (port 6543)
# Add ?pgbouncer=true&connection_limit=1 to the pooler URL
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# CORS — your Vercel frontend URL
FRONTEND_URL=https://tron-miner.vercel.app

# Admin (future)
ADMIN_TELEGRAM_IDS=123456789
